rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidWish(data) {
      return data.keys().hasAll(['name', 'status', 'message', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.status is string && (data.status == 'Hadir' || data.status == 'Tidak Hadir') &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.createdAt is timestamp;
    }

    match /wishes/{wishId} {
      allow read: if true;
      allow create: if isValidId(wishId) && isValidWish(incoming());
      allow update, delete: if false;
    }
  }
}
